[Unit]
Description=Deal Hunter watchdog — check if runs are fresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/deal-hunter
ExecStart=%h/Projects/deal-hunter/venv/bin/python deal_hunter.py --watchdog
EnvironmentFile=%h/Projects/deal-hunter/.env

[Install]
WantedBy=default.target
