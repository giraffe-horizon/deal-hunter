[Unit]
Description=Deal Hunter Telegram Feedback Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/deal-hunter
ExecStart=%h/Projects/deal-hunter/venv/bin/deal-hunter-bot
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=%h/Projects/deal-hunter/.env

[Install]
WantedBy=default.target
