[Unit]
Description=Deal Hunter — multi-source deal monitor
After=network-online.target
Wants=network-online.target
OnFailure=deal-hunter-notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/deal-hunter
ExecStart=%h/Projects/deal-hunter/venv/bin/deal-hunter --all
EnvironmentFile=%h/Projects/deal-hunter/.env

[Install]
WantedBy=default.target
