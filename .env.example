# Telegram Bot API token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat or group ID where alerts are sent
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Path to file containing Notion API key (optional, only if using Notion)
NOTION_API_KEY_PATH=~/.config/notion/api_key
