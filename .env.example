# Telegram Bot API token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat or group ID where alerts are sent
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Quiet Hours — suppress Telegram alerts during these hours (optional)
# QUIET_HOURS_START=22:00
# QUIET_HOURS_END=07:00

# Dashboard settings (optional)
# DEALS_PER_PAGE=50
# SCORE_THRESHOLD=70

# Database (default: sqlite:///state/deals.db)
# DATABASE_URL=sqlite:///state/deals.db
